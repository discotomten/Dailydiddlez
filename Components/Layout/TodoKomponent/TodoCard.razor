
<div class="todo-card @(Komprimerad ? "komprimera" : "") @(todo.ÄrFärdig ? "klar" : "")">
<strong>@todo.Titel</strong>
    @if (!Komprimerad)
    {
       <p>@todo.Beskrivning</p>
       @if(@todo.Slutdatum is {} datum) {<small>@datum.ToString("d MMM")</small>} 
    }
    <button class="btn-main">Markera klar</button>
    <button class="btn-second">Ta bort</button>
</div>

@code{
[Parameter, EditorRequired] public TodoModell todo {get; set;} = default!;
[Parameter] public bool Komprimerad {get; set;}
}