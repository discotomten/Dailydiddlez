@page "/todos"
@rendermode InteractiveServer
@using blazorHome.Components.Layout.TodoKomponent
@inject TodoService todoService
@inject NavigationManager nav

<div class="todo-header">
    <button @onclick="() => visaSkapa= true" class="btn-main">Ny todo</button>
</div>

<div class="card-grid">
    @foreach(var t in todos)
    {
        <TodoCard todo="t" />
    }    
</div>
<SkapaModal @bind-IsOpen="visaSkapa" OnCreated="LaddaAsync"/>

@code{
    bool visaSkapa;
    string? felmeddelande;

    List<TodoModell> todos = [];
    protected override async Task OnInitializedAsync() => await LaddaAsync();

    public async Task LaddaAsync()
    {
        todos = await todoService.GetAllAsync();
    }

    public async Task TaBortAsync(int id)
    {
        if(!await todoService.DeleteAsync(id))
        {
           felmeddelande = "Uppgiften finns inte längre"; 
        }
        await LaddaAsync();
    }
}